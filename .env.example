# Copy to .env for local development. On Vercel, set these in
# Project Settings → Environment Variables. Never commit real values.

# --- App ---------------------------------------------------------------
APP_ENV=development
# Public base URL, used for the CSRF origin check, passkeys and OAuth redirect URIs.
APP_BASE_URL=http://localhost:8000
# Shown in the header, page titles and passkey prompts.
APP_NAME=Our Parks

# Encrypts third-party tokens and sensitive records at rest, so the database alone
# reveals nothing. Keep a copy: without it, encrypted data can't be read.
# Use a different key in production. A Fernet key, generated with:
#   uv run --with cryptography python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Neon Postgres -----------------------------------------------------
# Pooled connection string from the Neon console (dev branch locally, main in
# production); keep sslmode=require.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Vercel Blob (only if the app stores files) ------------------------
# Added automatically when you connect a Blob store to the Vercel project.
# BLOB_READ_WRITE_TOKEN=

# --- App sign-in (passkeys + one-time invite links) ---------------------
# The admin account is created for this email on first setup.
ADMIN_EMAIL=
# Passkeys are bound to this domain (WebAuthn relying-party ID). Changing it
# later invalidates every passkey. Use localhost for local development.
WEBAUTHN_RP_ID=localhost
