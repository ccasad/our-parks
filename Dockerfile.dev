# Local development image. Linux x86_64 like Vercel, so packages install from
# prebuilt wheels (several no longer ship wheels for Intel Macs).
FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /uvx /usr/local/bin/

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_CACHE_DIR=/opt/uv-cache \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install dependencies at build time; the source is bind-mounted at runtime.
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-install-project

CMD ["uv", "run", "--frozen", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
